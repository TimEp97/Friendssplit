# FriendSplit – Sicherheits-Header und Caching (Apache, z. B. ALL-INKL.COM)
Options -Indexes
DirectoryIndex index.html

# Immer HTTPS (Cookies sind „Secure“, Teilen-Links brauchen HTTPS)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  # CSS/JS: Der Upload hängt ?v=<Version> an (siehe index.html). Mit Version darf der Browser die Datei
  # ein Jahr behalten – nach einem Update ändert sich die Adresse. Ohne Version (Upload von Hand) immer nachfragen.
  <FilesMatch "\.(css|js|svg)$">
    <If "%{QUERY_STRING} =~ /^v=/">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <Else>
      Header set Cache-Control "no-cache"
    </Else>
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
