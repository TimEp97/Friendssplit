# Kopieren nach .env und ausfüllen. .env wird nicht eingecheckt.

# Domain, unter der FriendSplit erreichbar sein soll (DNS-A-Record muss auf den Server zeigen)
DOMAIN=friendsplit.deine-domain.de

# Einmalig zum Anlegen des ersten Admin-Kontos (mind. 16 Zeichen, z. B. mit: openssl rand -hex 24).
# Nach der Einrichtung leeren und neu starten: docker compose up -d
SETUP_KEY=
